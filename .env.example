# Copia este archivo a .env.local (ignorado por git) y completa los valores.
# En uso hoy: NEXT_PUBLIC_SITE_URL (opcional), GHL_* (formularios de leads por la API de GHL) y NEXT_PUBLIC_GA_ID / NEXT_PUBLIC_META_PIXEL_ID (analítica, opcionales). El resto son las que preverá cada integración.
# Detalle y estado de cada una: docs/INTEGRACIONES.md
#
# ATENCIÓN: solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Nunca pongas secretos con ese prefijo.

# --- Sitio ---------------------------------------------------------------
# Dominio canónico, sin barra final (por defecto ya está en src/lib/contact.ts; confirmar si lleva www: docs/DECISIONES.md D-9)
NEXT_PUBLIC_SITE_URL=https://astupropiedad.com

# --- Contacto: teléfono y correo viven en src/lib/contact.ts (no son variables de entorno) ---

# --- GoHighLevel (CRM) ---------------------------------------------------
# EN USO (D-27): API v2 con el token de una integración privada. Solo servidor; nunca con NEXT_PUBLIC_.
# Con las cinco primeras, los formularios crean contacto + oportunidad (y cita donde se ofrece).
# Si falta alguna (o dice PENDIENTE), se usa GHL_WEBHOOK_URL y, sin ella, el plan B de WhatsApp.
# OJO: con el token real, `npm run dev` escribe en el GHL real. Prueba con datos ficticios.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_CALENDAR_ID=
# Opcional: etapa a la que pasa la oportunidad cuando la persona agenda la llamada.
GHL_PIPELINE_STAGE_CITA_ID=
# Solo para pruebas (e2e/ghl-falso.mjs). En Vercel no se define.
GHL_API_BASE_URL=
# Respaldo (D-18) mientras se confirma la API: webhook de entrada de leads.
GHL_WEBHOOK_URL=
# URL pública del calendario embebible (sin uso)
NEXT_PUBLIC_GHL_CALENDAR_URL=

# --- Anti-spam (Cloudflare Turnstile, opcional) --------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analítica (opcional) ------------------------------------------------
# Vacías = no se carga ningún script ni aparece el banner de cookies. Con valor, solo se cargan
# si el visitante pulsa "Aceptar". Se incrustan al compilar: tras cambiarlas, vuelve a desplegar.
# GA4: G-XXXXXXX · Meta: solo números. Un formato inválido se ignora. Ver docs/INTEGRACIONES.md §4.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Supabase (opcional, si el inventario se administra fuera del código) -
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca expongas esta clave.
SUPABASE_SERVICE_ROLE_KEY=
